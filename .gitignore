# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-performance-*/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa*
id_ed25519*
credentials.json
credentials.*.json
*-credentials.json
service-account*.json
.pgpass
pgpass.conf
.netrc

# database backups and local data
/backups/
/dumps/
*.bak
*.backup
*.dump
*.dump.sql
*.backup.sql
*_dump.sql
*.db
*.sqlite
*.sqlite3
/.migration-evidence/
*.migration-evidence.json
/migration-evidence*.json

# local sensitive tool configuration
.railway/
.supabase/
.npmrc
!.npmrc.example
.npmrc.local

# reports and logs that may contain sensitive values
gitleaks-report.*
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files (only the empty contract is versioned)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
